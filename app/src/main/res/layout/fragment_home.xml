<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/compactHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="14dp"
        android:visibility="invisible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOHSIN"
            android:textAppearance="@style/TextAppearance.Mohsin.MonoPrimary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/compactAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:minHeight="@dimen/touch_min"
            android:gravity="center_vertical"
            android:text="THEME"
            android:textAppearance="@style/TextAppearance.Mohsin.Mono" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <!-- Hero -->
            <TextView
                android:id="@+id/heroLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:text="@string/hero_location_label"
                android:textAppearance="@style/TextAppearance.Mohsin.Mono" />

            <TextView
                android:id="@+id/heroName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.Mohsin.Display"
                android:textSize="46sp" />

            <TextView
                android:id="@+id/heroHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/colorAccent"
                android:fontFamily="@font/cormorant_garamond"
                android:fontVariationSettings="\'wght\' 500"
                android:textSize="22sp"
                android:lineSpacingExtra="2sp" />

            <LinearLayout
                android:id="@+id/descriptorList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/heroIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAppearance="@style/TextAppearance.Mohsin.BodySecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ctaWork"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_view_work"
                    android:textSize="13sp" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ctaConnect"
                    style="@style/Widget.Mohsin.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_connect"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="48dp"
                android:background="@color/colorDivider" />

            <!-- 01 Introduction -->
            <include
                android:id="@+id/section01"
                layout="@layout/view_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp" />

            <TextView
                android:id="@+id/introBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.Mohsin.BodySecondary" />

            <TextView
                android:id="@+id/introLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="@dimen/touch_min"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/action_read_profile"
                android:textAppearance="@style/TextAppearance.Mohsin.MonoAccent" />

            <!-- 02 What I Create -->
            <include
                android:id="@+id/section02"
                layout="@layout/view_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp" />

            <LinearLayout
                android:id="@+id/whatCreateList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <!-- Bento row: 03 Selected Work + 04 Journey -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:minHeight="240dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <include
                        android:id="@+id/section03"
                        layout="@layout/view_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/workPreviewList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/workViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:text="@string/action_view_all"
                        android:textAppearance="@style/TextAppearance.Mohsin.MonoAccent" />
                </LinearLayout>

                <View
                    android:layout_width="12dp"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:minHeight="240dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <include
                        android:id="@+id/section04"
                        layout="@layout/view_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/journeyPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.Mohsin.BodySmall" />

                    <TextView
                        android:id="@+id/journeyLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:text="@string/action_view_all"
                        android:textAppearance="@style/TextAppearance.Mohsin.MonoAccent" />
                </LinearLayout>
            </LinearLayout>

            <!-- 05 Beyond (full width, uncarded) -->
            <include
                android:id="@+id/section05"
                layout="@layout/view_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp" />

            <TextView
                android:id="@+id/beyondBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.Mohsin.BodySecondary" />

            <LinearLayout
                android:id="@+id/beyondChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <!-- 06 CTA card (full width) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <include
                    android:id="@+id/section06"
                    layout="@layout/view_section_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/ctaBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAppearance="@style/TextAppearance.Mohsin.BodySecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ctaFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/action_connect" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="CRAFTED WITH INTENTION"
                android:textAppearance="@style/TextAppearance.Mohsin.Mono" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
