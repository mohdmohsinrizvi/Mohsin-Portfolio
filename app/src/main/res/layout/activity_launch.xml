<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorLaunchBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/monogram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M"
            android:textColor="#C8BDA8"
            android:fontFamily="@font/cormorant_garamond"
            android:fontVariationSettings="\'wght\' 500"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="\'wght\' 500"
            android:letterSpacing="0.34"
            android:text="MOHSIN"
            android:textColor="#F5F4F0"
            android:textSize="14sp" />

        <View
            android:id="@+id/hairline"
            android:layout_width="96dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#34363C" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/jetbrains_mono"
            android:fontVariationSettings="\'wght\' 400"
            android:letterSpacing="0.08"
            android:text="PORTFOLIO"
            android:textColor="#6F7075"
            android:textSize="10sp" />
    </LinearLayout>

</FrameLayout>
