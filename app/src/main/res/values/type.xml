<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Display: editorial serif -->
    <style name="TextAppearance.Mohsin.Display" parent="">
        <item name="android:fontFamily">@font/cormorant_garamond</item>
        <item name="android:fontVariationSettings">\'wght\' 500</item>
        <item name="android:textSize">44sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.Mohsin.DisplaySmall" parent="TextAppearance.Mohsin.Display">
        <item name="android:textSize">32sp</item>
