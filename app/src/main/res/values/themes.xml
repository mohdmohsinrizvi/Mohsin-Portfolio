<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Mohsin" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorOnPrimary">@color/colorOnAccent</item>
        <item name="colorPrimaryContainer">@color/colorSurfaceSecondary</item>
        <item name="colorOnPrimaryContainer">@color/colorTextPrimary</item>
        <item name="colorSecondary">@color/colorAccentMuted</item>
        <item name="colorOnSecondary">@color/colorOnAccent</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceSecondary</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorDivider</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="materialButtonStyle">@style/Widget.Mohsin.Button.Primary</item>
        <item name="android:textViewStyle">@style/Widget.Mohsin.TextView</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Mohsin.BottomSheet</item>
    </style>

    <style name="Theme.Mohsin.Launch" parent="Theme.Mohsin">
        <item name="android:windowBackground">@color/colorLaunchBackground</item>
        <item name="android:statusBarColor">@color/colorLaunchBackground</item>
        <item name="android:navigationBarColor">@color/colorLaunchBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Mohsin.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Mohsin.BottomSheet</item>
    </style>

    <style name="Widget.Mohsin.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Mohsin.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Mohsin.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Nav.Item" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:selectableItemBackground">@null</item>
    </style>

    <style name="Widget.Mohsin.TextView" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.Mohsin.Body</item>
    </style>

    <style name="Widget.Mohsin.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/colorAccentBright</item>
        <item name="android:textColor">@color/colorOnAccent</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@animator/press_squash</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Mohsin.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/colorCardStroke</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@animator/press_squash</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
